          "name": "xiangqi_games_revision_check",
          "value": "\"xiangqi_games\".\"revision\" >= 0"
        },
        "xiangqi_games_active_side_check": {
          "name": "xiangqi_games_active_side_check",
          "value": "\"xiangqi_games\".\"active_side\" IS NULL OR \"xiangqi_games\".\"active_side\" IN ('red', 'black')"
        },
        "xiangqi_games_clock_check": {
          "name": "xiangqi_games_clock_check",
          "value": "\"xiangqi_games\".\"red_clock_ms\" >= 0 AND \"xiangqi_games\".\"black_clock_ms\" >= 0"
        },
        "xiangqi_games_ready_check": {
          "name": "xiangqi_games_ready_check",
          "value": "\"xiangqi_games\".\"red_ready\" IN (0, 1) AND \"xiangqi_games\".\"black_ready\" IN (0, 1)"
        },
        "xiangqi_games_rematch_check": {
          "name": "xiangqi_games_rematch_check",
          "value": "\"xiangqi_games\".\"red_rematch\" IN (0, 1) AND \"xiangqi_games\".\"black_rematch\" IN (0, 1)"
        },
        "xiangqi_games_status_check": {
          "name": "xiangqi_games_status_check",
          "value": "\"xiangqi_games\".\"status\" IN ('active', 'finished')"
        },
        "xiangqi_games_result_check": {
          "name": "xiangqi_games_result_check",
          "value": "\"xiangqi_games\".\"result_kind\" IS NULL OR \"xiangqi_games\".\"result_kind\" IN ('checkmate', 'no-legal-move', 'repetition', 'timeout', 'resignation', 'draw-agreed')"
