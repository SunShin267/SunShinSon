        "xiangqi_games_players_check": {
          "name": "xiangqi_games_players_check",
          "value": "\"xiangqi_games\".\"red_session_id\" <> \"xiangqi_games\".\"black_session_id\""
        },
        "xiangqi_games_variant_check": {
